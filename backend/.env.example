APP_ENV=development
DATABASE_URL=sqlite:///./cameratrace.db
UPLOAD_DIR=./artifacts/uploads
MODEL_DIR=./models
ARTIFACT_DIR=./artifacts
MAX_UPLOAD_MB=25
CAMERA_MODEL_PATH=
MANIPULATION_MODEL_PATH=
AI_GENERATION_MODEL_PATH=
ENABLE_ROBUSTNESS=true
ENABLE_AI_DETECTOR=false
CAMERA_CLASSIFICATION_MODE=hierarchical
DEMO_MODE=false
LOG_LEVEL=INFO
ALLOWED_EXTENSIONS=jpg,jpeg,png,tiff,bmp,webp
